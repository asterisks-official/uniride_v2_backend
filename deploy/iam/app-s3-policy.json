{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadsObjectAccess",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::uniride-uploads-prod/*"
    },
    {
      "Sid": "BucketLocationForPresign",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::uniride-uploads-prod"
    }
  ]
}

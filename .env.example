# Application
NODE_ENV=production
PORT=3000

# Database (Railway PostgreSQL — copy DATABASE_URL from Railway dashboard)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Redis (Railway Redis — copy from Railway dashboard)
REDIS_HOST=host
REDIS_PORT=6379
REDIS_PASSWORD=password

# JWT (RS256)
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM contents with literal \n replacing actual newlines
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# AWS S3 + CloudFront
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_S3_BUCKET=your-bucket-name
AWS_CLOUDFRONT_URL=https://your-distribution.cloudfront.net

# Firebase FCM push notifications
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend (transactional email — https://resend.com)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="UniRide <noreply@yourdomain.com>"

# Sentry (https://sentry.io)
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Encryption key for PII (AES-256-GCM) — must be exactly 64 hex chars (32 bytes)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_string_here

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Google Places + Geocoding (server-side key, restrict by IP).
# Optional — place search falls back to a static Dhaka area list without it.
GOOGLE_MAPS_API_KEY=
